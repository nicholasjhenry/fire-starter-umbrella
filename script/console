#!/bin/sh
#MISE description="Launch a console for the application, locally or against a remote environment"
#USAGE arg "[environment]" help="Environment to connect to" default="development" {
#USAGE   choices "development" "production"
#USAGE }

set -e

environment="${usage_environment:-development}"

if [ "$environment" = "production" ]; then
    echo "==> Is SSH setup? fly ssh issue --agent"
    fly ssh console --pty -C "/app/bin/fire_fly remote"
else
    # Ensure the application is up to date before starting the local console.
    mise run update
    iex -S mix
fi
